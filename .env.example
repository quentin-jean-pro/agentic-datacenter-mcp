# Operating Mode
DRY_RUN=True

# LLM API Keys (Optional - System contains offline fallback mocks)
GOOGLE_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# FastMCP Server Ports
COMPUTE_MCP_HOST=0.0.0.0
COMPUTE_MCP_PORT=8001
COMPUTE_MCP_URL=http://localhost:8001/sse

POLICY_MCP_HOST=0.0.0.0
POLICY_MCP_PORT=8002
POLICY_MCP_URL=http://localhost:8002/sse

# Telemetry Monitoring Endpoint
TELEMETRY_ENDPOINT=http://localhost:9090/api/v1
PROMETHEUS_JOB=datacenter_gpu_metrics

# Multi-Tenant Vector DB & Local Embeddings
DATA_DIR=data_policies
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
